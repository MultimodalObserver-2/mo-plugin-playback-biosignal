{
  "name": "mo-sdk",
  "version": "1.0.1",
  "description": "Official SDK for building Multimodal Observer plugins",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && tsc-alias",
    "prepare": "npm run build"
  },
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/MultimodalObserver-2/mo-ui-sdk"
  },
  "files": [
    "dist/**/*"
  ],
  "bin": {
    "build-mop": "./dist/cli/build-mop.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./mo": {
      "import": "./dist/mo/index.js",
      "types": "./dist/types/mo/index.d.ts"
    },
    "./vite-plugins": {
      "import": "./dist/vite-plugins/index.js",
      "types": "./dist/types/vite-plugins/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.20.7",
    "@types/chalk": "^0.4.31",
    "@types/commander": "^2.12.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "vite": "^7.0.1"
  },
  "dependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "archiver": "^7.0.1",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "fs-extra": "^11.3.0",
    "i18next": "^25.3.2",
    "inquirer": "^12.9.3",
    "react-i18next": "^15.6.0"
  }
}
